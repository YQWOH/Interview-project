# ==============================================
# Panorama Application - Environment Configuration
# ==============================================

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=panorama
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/panorama?authSource=admin

# Backend Configuration
NODE_ENV=production
PORT=5000
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please
JWT_EXPIRES_IN=7d
UPLOAD_DIR=./uploads

# AI Service Configuration
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_NAME=Panorama AI Detection Service
AI_VERSION=1.0.0
AI_DEBUG=True
AI_MODEL_NAME=yolov5s
AI_CONFIDENCE_THRESHOLD=0.25
AI_MAX_DETECTIONS=50
AI_CORS_ORIGINS=http://localhost:3000,http://localhost:5000
AI_MAX_FILE_SIZE=52428800
AI_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
BACKEND_API_URL=http://backend:5000

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:5000

# Mongo Express Configuration
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
