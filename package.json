{
  "name": "panorama-application",
  "version": "1.0.0",
  "description": "Full-stack panorama image management application with AI object detection",
  "scripts": {
    "deploy": "./deploy-all.sh",
    "start": "docker-compose up -d",
    "stop": "./stop-all.sh",
    "down": "docker-compose down",
    "logs": "docker-compose logs -f",
    "logs:backend": "docker-compose logs -f backend",
    "logs:frontend": "docker-compose logs -f frontend",
    "logs:ai": "docker-compose logs -f ai-service",
    "logs:db": "docker-compose logs -f mongodb",
    "ps": "docker-compose ps",
    "restart": "docker-compose restart",
    "restart:backend": "docker-compose restart backend",
    "restart:frontend": "docker-compose restart frontend",
    "restart:ai": "docker-compose restart ai-service",
    "build": "docker-compose build",
    "build:backend": "docker-compose build backend",
    "build:frontend": "docker-compose build frontend",
    "build:ai": "docker-compose build ai-service",
    "clean": "docker-compose down -v",
    "health": "curl http://localhost:5000/health && curl http://localhost:8000/health && curl http://localhost:3000"
  },
  "keywords": [
    "panorama",
    "full-stack",
    "react",
    "express",
    "fastapi",
    "pytorch",
    "ai",
    "object-detection",
    "mongodb",
    "docker",
    "microservices"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
