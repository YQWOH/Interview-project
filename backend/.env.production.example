# ==============================================
# Production Environment Configuration Template
# ==============================================
# Copy this file to .env.production and update with SECURE values
# NEVER commit .env.production to version control!

# ==============================================
# Application Settings
# ==============================================
NODE_ENV=production
PORT=5000

# ==============================================
# MongoDB Configuration
# ==============================================
# IMPORTANT: Change these credentials in production!
# Generate strong passwords: openssl rand -base64 32
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

MONGO_DATABASE=panorama

# Full MongoDB Connection URI
# Replace with your production MongoDB host
MONGODB_URI=mongodb://admin:CHANGE_PASSWORD@mongodb:27017/panorama?authSource=admin

# ==============================================
# JWT Configuration
# ==============================================
# CRITICAL: Generate a strong random secret!
# Use: openssl rand -hex 64
JWT_SECRET=CHANGE_THIS_TO_64_CHAR_RANDOM_HEX_STRING
JWT_EXPIRES_IN=7d

# ==============================================
# File Upload Configuration
# ==============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==============================================
# CORS Configuration
# ==============================================
# Set to your frontend domain in production
CORS_ORIGIN=https://your-frontend-domain.com

# ==============================================
# Mongo Express (Disable in production!)
# ==============================================
# SECURITY: Do not expose Mongo Express in production
# Or use very strong credentials
MONGO_EXPRESS_USER=CHANGE_THIS
MONGO_EXPRESS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
