# ==============================================
# Environment Configuration Template
# ==============================================
# Copy this file to .env and update with your values
# NEVER commit .env to version control!

# ==============================================
# Application Settings
# ==============================================
NODE_ENV=development
PORT=5000

# ==============================================
# MongoDB Configuration
# ==============================================
# For Docker: Use service name 'mongodb'
# For Local: Use 'localhost'
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=admin123
MONGO_DATABASE=panorama

# Full MongoDB Connection URI
# Docker: mongodb://admin:admin123@mongodb:27017/panorama?authSource=admin
# Local:  mongodb://admin:admin123@localhost:27017/panorama?authSource=admin
MONGODB_URI=mongodb://admin:admin123@mongodb:27017/panorama?authSource=admin

# ==============================================
# JWT Configuration
# ==============================================
# IMPORTANT: Generate a strong secret for production!
# Use: openssl rand -hex 64
JWT_SECRET=your-super-secret-jwt-key-change-in-production-please
JWT_EXPIRES_IN=7d

# ==============================================
# File Upload Configuration
# ==============================================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ==============================================
# CORS Configuration
# ==============================================
CORS_ORIGIN=http://localhost:3000

# ==============================================
# Mongo Express (Optional - for database UI)
# ==============================================
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin123
